{
    # Изключваме автоматичните TLS сертификати, понеже Cloudflare тунелът прекратява SSL
    auto_https off
}

(fireradar) {
    # Доверяваме се на прокси заглавките от тунела/мрежата
    trusted_proxies private_ranges

    handle_path /api/* {
        reverse_proxy api:3000 {
            header_up X-Forwarded-For {http.request.header.CF-Connecting-Ip}
        }
    }

    handle /docs* {
        reverse_proxy api:3000 {
            header_up X-Forwarded-For {http.request.header.CF-Connecting-Ip}
        }
    }

    handle {
        reverse_proxy web:80 {
            header_up X-Forwarded-For {http.request.header.CF-Connecting-Ip}
        }
    }
}

:80 {
    import fireradar
}