{
    # Cloudflare тунелът прекратява HTTPS, затова Caddy слуша само HTTP
    auto_https off
}

(fireradar) {
    handle_path /api/* {
        reverse_proxy api:3000 {
            header_up X-Forwarded-For {http.request.header.CF-Connecting-Ip}
        }
    }

    handle /docs* {
        reverse_proxy api:3000 {
            header_up X-Forwarded-For {http.request.header.CF-Connecting-Ip}
        }
    }

    handle {
        reverse_proxy web:80 {
            header_up X-Forwarded-For {http.request.header.CF-Connecting-Ip}
        }
    }
}

:80 {
    import fireradar
}